# --- Secrets / config locale ------------------------------------------
backend/.env
frontend/.env
frontend/.env.production
frontend/.env.local

# --- Backend (PHP) -----------------------------------------------------
backend/vendor/
# Les photos produit du catalogue de départ SONT versionnées (voir
# Dockerfile) : elles doivent être présentes au clonage pour que le
# catalogue s'affiche dès le premier déploiement, avant même qu'un volume
# persistant existe. Seuls les fichiers ajoutés localement hors du dépôt
# resteraient ignorés — en pratique aucun ne l'est plus.

# --- Frontend (Node / Vite) ---------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# --- Éditeurs / OS -------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.log
