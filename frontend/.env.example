# Copiez ce fichier en ".env" (ou ".env.production" pour le build) et adaptez.

# URL de base de l'API PHP.
# - En développement local : laissez vide, Vite proxifie /api vers le backend (voir vite.config.js).
# - En production : mettez l'URL complète si l'API est sur un autre domaine/sous-domaine,
#   ex: VITE_API_URL=https://api.maboutique.sn
#   Si le frontend et le backend sont servis depuis le même domaine (ex: maboutique.sn/api/),
#   laissez aussi vide et faites pointer /api vers le dossier backend/ sur votre hébergement.
VITE_API_URL=
