# =====================================================================
# Copiez ce fichier en ".env" (même dossier) et adaptez les valeurs.
# Le fichier .env réel ne doit JAMAIS être versionné (voir .gitignore).
# =====================================================================

# --- Base de données -------------------------------------------------
# DB_DRIVER=mysql (par défaut, hébergement mutualisé / dev local) ou
# DB_DRIVER=pgsql (Supabase). Import du schéma correspondant :
# database/schema.sql (MySQL) ou database/schema.postgres.sql (Postgres).
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_boutique
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Exemple Supabase (Settings -> Database -> Connection string) : les
# nouveaux projets n'exposent plus que le "pooler" (pgbouncer), pas de
# connexion directe db.xxx.supabase.co. Prenez la variante SESSION (port
# 5432, pas 6543 "transaction") : le pilote PDO utilise de vraies requêtes
# préparées et PDO::lastInsertId(), qui ont besoin d'une connexion stable
# le temps d'une requête HTTP — le mode "transaction" du pooler peut
# changer de connexion serveur entre deux requêtes SQL et casser ça.
# DB_USER contient le project ref Supabase après un point (pas juste
# "postgres").
# DB_DRIVER=pgsql
# DB_HOST=aws-1-eu-west-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
# DB_PASS=<mot de passe défini à la création du projet Supabase>

# --- Authentification JWT --------------------------------------------
# Générez une chaîne longue et aléatoire, par ex : php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change_moi_avec_une_chaine_longue_et_aleatoire
JWT_EXPIRY=86400

# --- CORS --------------------------------------------------------------
# Domaines autorisés à appeler l'API, séparés par des virgules.
# Exemple production : https://boutique.example.sn
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Application ---------------------------------------------------------
# URL publique de l'API (sert à construire les liens vers les images uploadées)
APP_URL=http://localhost:8000

# --- Upload d'images produits -----------------------------------------
# Taille max en octets (ici 2 Mo)
UPLOAD_MAX_SIZE=2097152
