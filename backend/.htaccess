# =====================================================================
# Toutes les requêtes API passent par index.php (front controller),
# sauf les fichiers/dossiers qui existent réellement (ex: /uploads/...).
# =====================================================================
RewriteEngine On

# Beaucoup d'hébergements Apache/PHP (mod_php, CGI/FastCGI) ne transmettent
# PAS l'en-tête Authorization à PHP par défaut (getallheaders() ne le voit
# pas) — ce qui casse toute requête authentifiée (401 "Authentification
# requise" juste après connexion). Cette règle le recopie explicitement
# dans une variable d'environnement que Middleware::extraireToken() sait
# lire en repli ($_SERVER['HTTP_AUTHORIZATION']).
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Cache le contenu du dossier config/ et src/ si jamais accédé directement
<IfModule mod_authz_core.c>
    <FilesMatch "\.(env|sql|log)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(env|sql|log)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
